{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/heritage-short/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The single contract between every pipeline stage. Every stage reads this file; none of them write to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "film",
    "style",
    "characters",
    "providers",
    "music",
    "shots",
    "end_card"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "title_native",
        "logline",
        "language",
        "language_name",
        "audience",
        "intent",
        "target_duration_s"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title_native": {
          "type": "string",
          "minLength": 1
        },
        "logline": {
          "type": "string",
          "minLength": 10
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{3}$",
          "description": "ISO 639-3 code of the narration language"
        },
        "language_name": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 10
        },
        "intent": {
          "type": "string",
          "minLength": 10
        },
        "target_duration_s": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        },
        "line_tail_s": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2.0,
          "default": 0.9,
          "description": "Breath after each narration line before the cut (timeline pacing)."
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_block",
        "negative_prompt"
      ],
      "properties": {
        "style_block": {
          "type": "string",
          "minLength": 10,
          "description": "Appended to every image prompt, unchanged, to stop style drift"
        },
        "negative_prompt": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "real_person",
          "reference_prompt",
          "reference_seed"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Fixed character text injected into every prompt that names this character"
          },
          "real_person": {
            "type": "boolean",
            "description": "true if this depicts a real, identifiable person; requires a consent_ref"
          },
          "consent_ref": {
            "type": "string",
            "description": "Anchor in ETHICS.md recording consent"
          },
          "reference_prompt": {
            "type": "string"
          },
          "reference_seed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "if": {
          "properties": {
            "real_person": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "consent_ref"
          ]
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyframes",
        "shots",
        "music",
        "narration"
      ],
      "description": "Ordered fallback chain per stage. The first provider that is available and succeeds wins.",
      "properties": {
        "keyframes": {
          "$ref": "#/$defs/chain"
        },
        "shots": {
          "$ref": "#/$defs/chain"
        },
        "music": {
          "$ref": "#/$defs/chain"
        },
        "narration": {
          "$ref": "#/$defs/chain"
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption",
        "candidates",
        "chosen",
        "segment_s",
        "cues",
        "duck"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 10
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Seeds; one audio candidate per seed"
        },
        "chosen": {
          "type": "integer",
          "minimum": 0,
          "description": "Seed of the chosen candidate; must appear in candidates"
        },
        "chosen_reason": {
          "type": "string"
        },
        "segment_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 150,
          "description": "Length of each candidate. ACE-Step can render the whole film (one evolving track, no looping); local models are capped at 30 s and looped."
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at_shot",
              "action",
              "note"
            ],
            "properties": {
              "at_shot": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "start",
                  "swell",
                  "dip",
                  "out"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold",
            "ratio",
            "attack_ms",
            "release_ms",
            "bed_gain_db"
          ],
          "properties": {
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 20
            },
            "attack_ms": {
              "type": "number",
              "minimum": 1
            },
            "release_ms": {
              "type": "number",
              "minimum": 1
            },
            "bed_gain_db": {
              "type": "number",
              "maximum": 0
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "shot_size",
          "characters",
          "image_prompt",
          "seed",
          "motion_prompt",
          "kenburns",
          "narration",
          "subtitle_en",
          "min_duration_s"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists, in one sentence"
          },
          "shot_size": {
            "enum": [
              "extreme-wide",
              "wide",
              "medium",
              "medium-close-up",
              "close-up",
              "extreme-close-up",
              "insert"
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "motion_prompt": {
            "type": "string",
            "description": "Motion and camera only, for image-to-video"
          },
          "kenburns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zoom_from",
              "zoom_to",
              "pan"
            ],
            "properties": {
              "zoom_from": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.6
              },
              "zoom_to": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.6
              },
              "pan": {
                "enum": [
                  "none",
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              }
            }
          },
          "narration": {
            "type": "string",
            "description": "Narration in the film language; may be empty for a silent beat"
          },
          "subtitle_en": {
            "type": "string"
          },
          "narration_delay_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "default": 0.4
          },
          "min_duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "music_only": {
            "type": "boolean",
            "default": false
          },
          "ref_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.5,
            "maximum": 1.0,
            "description": "img2img strength on the first character's reference image; null = txt2img (prompt decides composition). See EXPERIMENTS.md E07."
          },
          "animate": {
            "type": "boolean",
            "default": true,
            "description": "Send this shot to Wan 2.2 image-to-video. false = Ken Burns only (saves GPU time for shots that do not need motion)."
          },
          "transition_in": {
            "enum": [
              "cut",
              "dissolve"
            ],
            "default": "cut",
            "description": "How this shot enters. dissolve = cross-dissolve from the previous shot; total length and narration sync are unchanged."
          },
          "transition_s": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 2.5,
            "default": 1.0
          },
          "wan_qc": {
            "type": "string",
            "pattern": "^(pass|reject): .+",
            "description": "Human QC verdict on this shot's Wan clip, with the reason. 'reject: ...' makes the shots stage use Ken Burns even though a clip exists."
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "description": "Subject position in the square keyframe (0-1). The 9:16 crop is centred on x, the 16:9 crop on y, instead of the image centre."
          },
          "keyframe_from": {
            "type": "string",
            "pattern": "^s[0-9]{2}$",
            "description": "Reuse another shot's keyframe (same person by construction); framing comes from focus and kenburns."
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "duration_s"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "Narrator direction; used by hosted TTS (Gemini). MMS ignores it.",
      "properties": {
        "style": {
          "type": "string"
        },
        "gemini_voice": {
          "type": "string"
        },
        "gemini_model": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}