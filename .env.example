# Copy to .env (git-ignored). Every key is optional: without them the pipeline falls back to
# the local open-weight providers listed in storyboard.json.

# Gemini API (Google AI Studio) - narration via Gemini TTS
GEMINI_API_KEY=
# Set to the current TTS model id shown in AI Studio (the default below may have been retired)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Sulafat

# Cloudflare Workers AI - keyframes via FLUX
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local tuning (defaults shown)
KEYFRAME_SIZE=512
KEYFRAME_STEPS=4
KEYFRAME_REF_STRENGTH=0.8
MMS_SPEAKING_RATE=1.0
